<Project Sdk="Microsoft.NET.Sdk">
  <!-- Game-free tests: only the pure logic files are linked in, so this runs without Nuclear Option installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\BaanishUiImprovements\Runways\ApproachSelector.cs" Link="Runways\ApproachSelector.cs" />
    <Compile Include="..\..\src\BaanishUiImprovements\Runways\RunwayNames.cs" Link="Runways\RunwayNames.cs" />
  </ItemGroup>
</Project>
